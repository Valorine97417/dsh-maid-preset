{
  "name": "dsh-maid-preset",
  "description": "DSH 女仆预设「小困」——自带 maid 预设、全局女仆人设与内置记忆 meow-memory（代码随包，无需单独安装）。装一个包，走到哪都是小困。",
  "version": "0.7.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "maid",
    "preset",
    "persona"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "files": [
    "lib",
    "memory",
    "defaults",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./meow": "./lib/meow/index.js",
    "./meow/client": "./lib/meow/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
